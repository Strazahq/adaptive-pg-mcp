#!/bin/sh
# Push gate: secrets, known vulnerabilities, the database tests on Postgres 14
# to 18 and the MCP specification revision.
# A missing scanner refuses the push, because a skipped scan is a scan that
# never happened.
set -u
root=$(git rev-parse --show-toplevel)
cd "$root" || exit 1

need() {
  command -v "$1" >/dev/null 2>&1 && return 0
  echo "gate: $1 is not installed, so the push is refused. Install it ($2) and push again." >&2
  exit 1
}

need gitleaks "https://github.com/gitleaks/gitleaks"
if ! gitleaks git --no-banner --redact . >/dev/null 2>&1; then
  echo "gate: gitleaks found a secret in the history. Run gitleaks git --redact . and remove it before pushing." >&2
  exit 1
fi

if [ -f go.mod ]; then
  need govulncheck "go install golang.org/x/vuln/cmd/govulncheck@latest"
  if ! govulncheck ./... >/dev/null 2>&1; then
    echo "gate: govulncheck reports a reachable vulnerability. Run govulncheck ./... and update the dependency." >&2
    exit 1
  fi
  need osv-scanner "go install github.com/google/osv-scanner/v2/cmd/osv-scanner@latest"
  if ! osv-scanner scan source -r . >/dev/null 2>&1; then
    echo "gate: osv-scanner reports a known vulnerability in a dependency. Run osv-scanner scan source -r . and update it." >&2
    exit 1
  fi

  # The database tests run on the Postgres 14 to 18 harness, which is removed
  # again whatever the tests do, also when the push is interrupted.
  trap 'sh tools/pg.sh down >/dev/null 2>&1; exit 1' INT TERM HUP
  if ! sh tools/pg.sh up; then
    sh tools/pg.sh down >/dev/null 2>&1
    echo "gate: the Postgres 14 to 18 harness did not start, so the push is refused. Fix what tools/pg.sh printed above and push again." >&2
    exit 1
  fi
  go test -tags pg ./... >/dev/null 2>&1
  tested=$?
  if ! sh tools/pg.sh down; then
    echo "gate: the Postgres 14 to 18 harness was not removed, so the push is refused. Fix what tools/pg.sh printed above and run sh tools/pg.sh down." >&2
    exit 1
  fi
  trap - INT TERM HUP
  if [ "$tested" -ne 0 ]; then
    echo "gate: a database test fails on Postgres 14 to 18. Run make pgtest and read the first FAIL." >&2
    exit 1
  fi
fi

if ! sh tools/specgate.sh; then exit 1; fi
exit 0
